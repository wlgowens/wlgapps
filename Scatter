<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Classroom Scattergories</title>
  <!-- Tailwind CSS CDN for quick styling -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 h-screen flex flex-col font-sans overflow-hidden">

  <!-- TOP HEADER -->
  <header class="bg-indigo-600 text-white px-6 py-3 flex justify-between items-center shadow-md shrink-0">
    <h1 class="text-2xl font-extrabold tracking-wide">SCATTERGORIES</h1>
    <div class="flex gap-3">
      <button onclick="generateNewRound()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-4 py-2 rounded-lg shadow transition">
        🎲 New Round
      </button>
      <button onclick="addTeam()" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-4 py-2 rounded-lg shadow transition">
        ➕ Add Team
      </button>
    </div>
  </header>

  <!-- MAIN MAIN CONTAINER -->
  <div class="flex flex-1 overflow-hidden p-4 gap-4">

    <!-- LEFT COLUMN: Letter, Timer, Categories (~30-35% width) -->
    <div class="w-1/3 bg-white rounded-xl shadow-lg p-5 flex flex-col border border-slate-200">
      
      <!-- Letter & Timer Row -->
      <div class="flex justify-between items-center mb-4 bg-indigo-50 p-4 rounded-lg border border-indigo-100">
        <!-- Letter Display -->
        <div class="text-center">
          <div class="text-xs font-bold uppercase tracking-wider text-indigo-500">Letter</div>
          <div id="target-letter" class="text-5xl font-black text-indigo-700">A</div>
        </div>

        <!-- Timer Display -->
        <div class="text-center">
          <div class="text-xs font-bold uppercase tracking-wider text-indigo-500">Time Remaining</div>
          <div id="timer-display" class="text-4xl font-mono font-bold text-slate-800">03:00</div>
        </div>

        <!-- Timer Controls -->
        <div class="flex flex-col gap-1">
          <button id="timer-btn" onclick="toggleTimer()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3 py-1 text-sm rounded shadow">Start</button>
          <button onclick="resetTimer()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-3 py-1 text-xs rounded">Reset</button>
        </div>
      </div>

      <!-- Categories List -->
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-2">Categories</h2>
      <div class="flex-1 overflow-y-auto pr-2">
        <ol id="categories-list" class="space-y-2 text-sm font-medium text-slate-700">
          <!-- Categories populated via JS -->
        </ol>
      </div>
    </div>

    <!-- RIGHT COLUMN: Teams & Auto Scoring Area (~65-70% width) -->
    <div class="w-2/3 bg-white rounded-xl shadow-lg p-5 flex flex-col border border-slate-200">
      <div class="flex justify-between items-center mb-3">
        <h2 class="text-lg font-bold text-slate-800">Team Answers & Auto-Scoring</h2>
        <button onclick="calculateScores()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2 rounded-lg shadow text-sm">
          📊 Calculate Scores
        </button>
      </div>

      <!-- Teams Container (Scrollable Horizontally) -->
      <div id="teams-container" class="flex-1 flex gap-4 overflow-x-auto pb-2">
        <!-- Team Columns will be dynamically generated here -->
      </div>
    </div>

  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Master List of Categories
    const categoryPool = [
      "A boy's name", "U.S. Cities", "Things that are cold", "School subjects",
      "Animals", "Things you see in a classroom", "Foods", "Hobbies",
      "Famous people", "Things that are round", "Clothing items", "Movies",
      "A girl's name", "Types of candy", "Occupations", "Sports teams",
      "Things at a beach", "Items in a refrigerator", "Car parts", "Superheroes"
    ];

    const letters = "ABCDEFGHIJKLMNOPRSTW"; // Excluded Q, U, V, X, Y, Z for better gameplay
    let currentLetter = "A";
    let categories = [];
    let teams = ["Team 1", "Team 2"];
    
    // Timer Variables
    let timerSeconds = 180;
    let timerInterval = null;

    // Initialize Game
    function init() {
      generateNewRound();
    }

    function generateNewRound() {
      // Pick random letter
      currentLetter = letters[Math.floor(Math.random() * letters.length)];
      document.getElementById("target-letter").innerText = currentLetter;

      // Pick 12 random categories
      const shuffled = [...categoryPool].sort(() => 0.5 - Math.random());
      categories = shuffled.slice(0, 12);

      renderCategories();
      renderTeams();
      resetTimer();
    }

    function renderCategories() {
      const listEl = document.getElementById("categories-list");
      listEl.innerHTML = categories.map((cat, i) => `
        <li class="bg-slate-50 p-2.5 rounded border border-slate-100 flex items-center gap-2">
          <span class="w-5 h-5 bg-indigo-100 text-indigo-700 font-bold rounded-full flex items-center justify-center text-xs">${i+1}</span>
          <span class="truncate">${cat}</span>
        </li>
      `).join('');
    }

    function renderTeams() {
      const container = document.getElementById("teams-container");
      container.innerHTML = teams.map((teamName, teamIdx) => `
        <div class="w-64 shrink-0 bg-slate-50 border border-slate-200 rounded-lg p-3 flex flex-col h-full">
          <div class="flex justify-between items-center mb-3 pb-2 border-b">
            <input type="text" value="${teamName}" onchange="teams[${teamIdx}] = this.value" 
                   class="font-bold text-slate-800 bg-transparent border-b border-transparent hover:border-slate-300 focus:border-indigo-500 focus:bg-white outline-none px-1 rounded w-32">
            <div id="score-team-${teamIdx}" class="text-xl font-extrabold text-indigo-600">0 pts</div>
          </div>

          <div class="flex-1 overflow-y-auto space-y-2 pr-1">
            ${categories.map((_, catIdx) => `
              <div class="flex flex-col">
                <input type="text" 
                       id="ans-${teamIdx}-${catIdx}" 
                       placeholder="${catIdx + 1}. Answer..." 
                       class="team-input-${teamIdx} text-sm p-1.5 border rounded focus:ring-2 focus:ring-indigo-400 outline-none transition">
                <span id="feedback-${teamIdx}-${catIdx}" class="text-[10px] font-bold px-1 mt-0.5 min-h-[14px]"></span>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function addTeam() {
      teams.push(`Team ${teams.length + 1}`);
      renderTeams();
    }

    // Auto Scoring Logic based on official Scattergories Rules
    function calculateScores() {
      let teamScores = new Array(teams.length).fill(0);

      // Clean string helper (remove leading A, An, The)
      const sanitize = (str) => {
        let clean = str.trim().toUpperCase();
        clean = clean.replace(/^(THE|AN|A)\s+/, '');
        return clean;
      };

      for (let c = 0; c < categories.length; c++) {
        let categoryAnswers = [];

        // Collect answers for this category across all teams
        for (let t = 0; t < teams.length; t++) {
          const inputEl = document.getElementById(`ans-${t}-${c}`);
          const rawVal = inputEl ? inputEl.value : "";
          const cleanVal = sanitize(rawVal);
          categoryAnswers.push({ teamIdx: t, raw: rawVal, clean: cleanVal });
        }

        // Check duplicates
        categoryAnswers.forEach((item, _, arr) => {
          const feedbackEl = document.getElementById(`feedback-${item.teamIdx}-${c}`);
          const inputEl = document.getElementById(`ans-${item.teamIdx}-${c}`);
          
          if (!item.clean) {
            feedbackEl.innerText = "";
            inputEl.className = "team-input-" + item.teamIdx + " text-sm p-1.5 border rounded border-slate-200";
            return;
          }

          // Rule 1: First letter must match
          const startsWithLetter = item.clean.startsWith(currentLetter);

          // Rule 2: Must be unique among all non-empty submissions
          const isDuplicate = arr.filter(other => other.clean === item.clean).length > 1;

          if (!startsWithLetter) {
            feedbackEl.innerText = `❌ Doesn't start with ${currentLetter}`;
            feedbackEl.className = "text-[10px] font-bold text-red-500 px-1 mt-0.5";
            inputEl.className = "team-input-" + item.teamIdx + " text-sm p-1.5 border rounded border-red-300 bg-red-50";
          } else if (isDuplicate) {
            feedbackEl.innerText = "❌ Duplicate answer (0 pts)";
            feedbackEl.className = "text-[10px] font-bold text-amber-600 px-1 mt-0.5";
            inputEl.className = "team-input-" + item.teamIdx + " text-sm p-1.5 border rounded border-amber-300 bg-amber-50";
          } else {
            feedbackEl.innerText = "✔ +1 Pt";
            feedbackEl.className = "text-[10px] font-bold text-emerald-600 px-1 mt-0.5";
            inputEl.className = "team-input-" + item.teamIdx + " text-sm p-1.5 border rounded border-emerald-300 bg-emerald-50";
            teamScores[item.teamIdx] += 1;
          }
        });
      }

      // Update total scores
      teamScores.forEach((score, idx) => {
        document.getElementById(`score-team-${idx}`).innerText = `${score} pts`;
      });
    }

    // Timer Controls
    function toggleTimer() {
      const btn = document.getElementById("timer-btn");
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
        btn.innerText = "Start";
        btn.className = "bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3 py-1 text-sm rounded shadow";
      } else {
        timerInterval = setInterval(() => {
          if (timerSeconds > 0) {
            timerSeconds--;
            updateTimerDisplay();
          } else {
            clearInterval(timerInterval);
            timerInterval = null;
            alert("⏰ Time's Up!");
            calculateScores();
          }
        }, 1000);
        btn.innerText = "Pause";
        btn.className = "bg-amber-500 hover:bg-amber-600 text-white font-bold px-3 py-1 text-sm rounded shadow";
      }
    }

    function resetTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      timerSeconds = 180;
      updateTimerDisplay();
      document.getElementById("timer-btn").innerText = "Start";
      document.getElementById("timer-btn").className = "bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3 py-1 text-sm rounded shadow";
    }

    function updateTimerDisplay() {
      const mins = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
      const secs = (timerSeconds % 60).toString().padStart(2, '0');
      document.getElementById("timer-display").innerText = `${mins}:${secs}`;
    }

    window.onload = init;
  </script>
</body>
</html>
